# Production Docker Environment
# Use this for production deployment

# === APPLICATION ===
APP_NAME="Parish Management System"
APP_ENV=production
APP_KEY=base64:GENERATE_NEW_KEY_FOR_PRODUCTION
APP_DEBUG=false
APP_URL=https://parish.quovadisyouthhub.org

# === DATABASE (Production MySQL) ===
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=parish_production
DB_USERNAME=parish_prod_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

# === CACHE & SESSION (Production Redis) ===
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# === QUEUE ===
QUEUE_CONNECTION=redis

# === MAIL ===
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@parish.quovadisyouthhub.org"
MAIL_FROM_NAME="${APP_NAME}"

# === BROADCASTING ===
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# === ASSET URL ===
ASSET_URL=https://parish.quovadisyouthhub.org

# === VITE ===
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# === PERFORMANCE ===
OPCACHE_ENABLE=1
OPCACHE_MEMORY_CONSUMPTION=256
OPCACHE_MAX_ACCELERATED_FILES=10000
VIEW_CACHE_ENABLED=1
CONFIG_CACHE_ENABLED=1

# === LOGGING ===
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# === SECURITY ===
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
