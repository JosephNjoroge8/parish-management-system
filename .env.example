# ===========# Localization  
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Nairobi

# Maintenance & Performance
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging Configuration - Optimized for Production
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14==========
# PARISH MANAGEMENT SYSTEM - PRODUCTION ENVIRONMENT
# ====================================
# COPY THIS TO YOUR PRODUCTION SERVER AS .env
# UPDATE THE DATABASE CREDENTIALS WITH YOUR ACTUAL cPANEL VALUES

# Application Configuration
APP_NAME="Parish Management System"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://parish.quovadisyouthhub.org

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance & Performance
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ====================================
# DATABASE CONFIGURATION - UPDATE THESE VALUES
# ====================================
# Replace with your actual cPanel database credentials:
# 1. Go to cPanel → MySQL Databases
# 2. Create database: cpanel_username_parish
# 3. Create user: cpanel_username_parishuser  
# 4. Grant ALL PRIVILEGES
# 5. Replace the values below:

DB_CONNECTION=production
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_YOUR_CPANEL_DB_NAME
DB_USERNAME=REPLACE_WITH_YOUR_CPANEL_DB_USER
DB_PASSWORD=REPLACE_WITH_YOUR_CPANEL_DB_PASSWORD

# ====================================
# SESSION & SECURITY CONFIGURATION - ENHANCED
# ====================================
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=quovadisyouthhub.org
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Broadcasting & Queue
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

# Cache Configuration - Optimized
CACHE_STORE=database
CACHE_PREFIX=parish_

# Storage
FILESYSTEM_DISK=local

# ====================================
# REDIS & MEMORY CACHE (OPTIONAL)
# ====================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ====================================
# MAIL CONFIGURATION - UPDATE WITH YOUR SMTP
# ====================================
# Replace with your actual email settings:
MAIL_MAILER=smtp
MAIL_HOST=mail.quovadisyouthhub.org
MAIL_PORT=587
MAIL_USERNAME=parish@quovadisyouthhub.org
MAIL_PASSWORD=REPLACE_WITH_YOUR_EMAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="parish@quovadisyouthhub.org"
MAIL_FROM_NAME="${APP_NAME}"

# ====================================
# SECURITY & SANCTUM CONFIGURATION
# ====================================
SANCTUM_STATEFUL_DOMAINS=parish.quovadisyouthhub.org
# ====================================
# ASSET & PRODUCTION OPTIMIZATION
# ====================================
ASSET_URL=https://parish.quovadisyouthhub.org

# CRITICAL: NO VITE DEV SERVER IN PRODUCTION
# Assets are served from /public/build/ directory

# ====================================
# PRODUCTION SECURITY SETTINGS
# ====================================
# Force HTTPS redirect (handled by .htaccess)
FORCE_HTTPS=true

# Rate limiting for API routes
THROTTLE_API=60,1

# Database query logging (disabled for performance)
DB_LOG_QUERIES=false

# Content Security Policy
CSP_ENABLED=false

# ====================================
# PUSHER CONFIGURATION (IF USING REAL-TIME FEATURES)
# ====================================
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
