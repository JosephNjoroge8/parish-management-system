<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>
    
    RewriteEngine On
    
    # ========================================
    # CRITICAL: Force PHP 8.2 (FIX FOR YOUR ERROR)
    # ========================================
    <IfModule mime_module>
        AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
    </IfModule>
    
    # Fallback for different cPanel configurations
    <FilesMatch "\.(php|phtml)$">
        SetHandler application/x-httpd-ea-php82
    </FilesMatch>
    
    # ========================================
    # ASSET SERVING (CRITICAL - Before Laravel Routing)
    # ========================================
    # Serve static files directly (images, fonts, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} !index\.php
    RewriteRule \.(css|js|mjs|json|jpg|jpeg|png|gif|svg|webp|woff|woff2|ttf|otf|ico)$ - [L]
    
    # Serve build directory assets directly
    RewriteCond %{REQUEST_URI} ^/build/
    RewriteRule ^ - [L]
    
    # ========================================
    # MIME TYPES FOR VITE ASSETS
    # ========================================
    <IfModule mod_mime.c>
        # JavaScript
        AddType application/javascript .js
        AddType application/javascript .mjs
        AddType module .mjs
        
        # CSS
        AddType text/css .css
        
        # JSON & Manifest
        AddType application/json .json
        AddType application/manifest+json .webmanifest
        
        # Images
        AddType image/svg+xml .svg
        AddType image/webp .webp
        
        # Fonts
        AddType font/woff .woff
        AddType font/woff2 .woff2
        AddType font/ttf .ttf
        AddType font/otf .otf
    </IfModule>
    
    # Force correct Content-Type for JavaScript modules
    <FilesMatch "\.(js|mjs)$">
        <IfModule mod_headers.c>
            Header set Content-Type "application/javascript; charset=utf-8"
        </IfModule>
    </FilesMatch>
    
    # Force correct Content-Type for CSS
    <FilesMatch "\.css$">
        <IfModule mod_headers.c>
            Header set Content-Type "text/css; charset=utf-8"
        </IfModule>
    </FilesMatch>
    
    # ========================================
    # HTTPS ENFORCEMENT (Conditional)
    # ========================================
    # Only enforce HTTPS in production, skip for localhost
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    
    # ========================================
    # AUTHORIZATION HEADER PASS-THROUGH
    # ========================================
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    
    # ========================================
    # SECURITY HEADERS
    # ========================================
    <IfModule mod_headers.c>
        # Prevent clickjacking
        Header always set X-Frame-Options "SAMEORIGIN"
        
        # Prevent MIME sniffing
        Header always set X-Content-Type-Options "nosniff"
        
        # XSS Protection (legacy browsers)
        Header always set X-XSS-Protection "1; mode=block"
        
        # Referrer Policy
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        
        # Permissions Policy (optional - adjust as needed)
        Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    </IfModule>
    
    # ========================================
    # BROWSER CACHING FOR ASSETS
    # ========================================
    <IfModule mod_expires.c>
        ExpiresActive On
        
        # Vite builds with content hashes - cache aggressively
        <FilesMatch "\.(css|js|mjs)$">
            ExpiresDefault "access plus 1 year"
        </FilesMatch>
        
        # Images
        ExpiresByType image/png "access plus 1 year"
        ExpiresByType image/jpg "access plus 1 year"
        ExpiresByType image/jpeg "access plus 1 year"
        ExpiresByType image/gif "access plus 1 year"
        ExpiresByType image/webp "access plus 1 year"
        ExpiresByType image/svg+xml "access plus 1 year"
        
        # Fonts
        ExpiresByType font/woff "access plus 1 year"
        ExpiresByType font/woff2 "access plus 1 year"
        ExpiresByType font/ttf "access plus 1 year"
        ExpiresByType font/otf "access plus 1 year"
        
        # Manifest
        ExpiresByType application/manifest+json "access plus 1 week"
    </IfModule>
    
    # Cache-Control headers for hashed assets
    <IfModule mod_headers.c>
        <FilesMatch "\.(css|js|mjs|woff|woff2|ttf|otf|png|jpg|jpeg|gif|webp|svg)$">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </FilesMatch>
    </IfModule>
    
    # ========================================
    # LARAVEL ROUTING
    # ========================================
    # Remove trailing slashes (except for directories)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]
    
    # Route all requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
    
    # ========================================
    # SECURITY: BLOCK ACCESS TO SENSITIVE FILES
    # ========================================
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    
    <FilesMatch "(composer\.(json|lock)|package(-lock)?\.json|\.env|\.git)">
        Require all denied
    </FilesMatch>
</IfModule>
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
