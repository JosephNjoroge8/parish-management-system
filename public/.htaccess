<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # CRITICAL: PHP Handler Configuration
    AddHandler application/x-httpd-php .php
    AddType application/x-httpd-php .php
    
    # Alternative PHP handlers for different hosting environments
    <IfModule mod_php.c>
        SetHandler application/x-httpd-php
    </IfModule>
    
    <FilesMatch "\.(php|phtml)$">
        SetHandler application/x-httpd-php
    </FilesMatch>

    # CRITICAL: Asset serving BEFORE Laravel routing
    RewriteCond %{REQUEST_URI} ^/build/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # CRITICAL: Force correct MIME types for JavaScript files
    <FilesMatch "\.(js|mjs)$">
        <IfModule mod_mime.c>
            ForceType application/javascript
        </IfModule>
        <IfModule mod_headers.c>
            Header set Content-Type "application/javascript; charset=utf-8"
        </IfModule>
    </FilesMatch>

    # Force correct MIME types for CSS files
    <FilesMatch "\.css$">
        <IfModule mod_mime.c>
            ForceType text/css
        </IfModule>
        <IfModule mod_headers.c>
            Header set Content-Type "text/css; charset=utf-8"
        </IfModule>
    </FilesMatch>

    # MIME Types
    <IfModule mod_mime.c>
        AddType application/javascript .js
        AddType application/javascript .mjs
        AddType text/css .css
        AddType application/json .json
        AddType image/svg+xml .svg
        AddType font/woff .woff
        AddType font/woff2 .woff2
    </IfModule>

    # Force HTTPS in production
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} parish\.quovadisyouthhub\.org$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Security Headers
    <IfModule mod_headers.c>
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-XSS-Protection "1; mode=block"
    </IfModule>

    # Asset Caching
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresByType text/css "access plus 1 year"
        ExpiresByType application/javascript "access plus 1 year"
        ExpiresByType image/png "access plus 1 year"
        ExpiresByType image/jpg "access plus 1 year"
        ExpiresByType image/jpeg "access plus 1 year"
        ExpiresByType image/gif "access plus 1 year"
        ExpiresByType image/webp "access plus 1 year"
        ExpiresByType font/woff "access plus 1 year"
        ExpiresByType font/woff2 "access plus 1 year"
    </IfModule>

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
