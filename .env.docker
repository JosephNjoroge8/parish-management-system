# Docker Environment Variables
# Copy this to .env for Docker development

# === APPLICATION ===
APP_NAME="Parish Management System"
APP_ENV=local
APP_KEY=base64:EIEVxVe7w4kk122AnMuZT8WPiLjrNpT+88Y/42yIhJg=
APP_DEBUG=true
APP_URL=http://localhost:8000

# === DATABASE (Docker MySQL) ===
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=parish_system
DB_USERNAME=parish_user
DB_PASSWORD=parish_secret
DB_ROOT_PASSWORD=root_secret

# === CACHE & SESSION (Docker Redis) ===
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# === QUEUE ===
QUEUE_CONNECTION=redis

# === MAIL ===
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025

# === BROADCASTING ===
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# === VITE ===
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# === PERFORMANCE ===
OPCACHE_ENABLE=1
VIEW_CACHE_ENABLED=0
CONFIG_CACHE_ENABLED=0
