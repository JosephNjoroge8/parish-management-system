# ============================================================================
# PARISH MANAGEMENT SYSTEM - PRODUCTION .GITIGNORE
# ============================================================================
# This file prevents sensitive and unnecessary files from being committed to Git
# Optimized for production deployment to GitHub
# ============================================================================

# ============================================================================
# Environment files (CRITICAL - NEVER COMMIT)
# ============================================================================
.env
.env.*
!.env.example
.env.backup
.env.production
.env.local
.env.staging
.env.testing

# Authentication & API Keys
auth.json
oauth-private.key
oauth-public.key

# ============================================================================
# DATABASE FILES (CRITICAL - CONTAINS SENSITIVE DATA)
# ============================================================================
# SQLite databases
*.sqlite
*.sqlite3
*.db
/database/*.sqlite
/database/*.sqlite3
/database/*.db
/database/database.*

# Database backups and dumps
*.sql
*.dump
/database/backups/
/storage/database-backups/

# ============================================================================
# APPLICATION LOGS & TEMPORARY FILES
# ============================================================================
# Laravel logs
/storage/logs/*.log
/storage/logs/*

# General log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================================
# GENERATED & CACHED FILES
# ============================================================================
# Laravel optimization files
/bootstrap/cache/*.php
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
/storage/framework/testing/

# Compiled assets (Allow production builds, ignore development artifacts)
/public/hot
/public/storage
mix-manifest.json.backup

# Cache files
.phpunit.result.cache
.phpunit.cache
/storage/pail
*.cache

# ============================================================================
# DEPENDENCIES & PACKAGES
# ============================================================================
composer.phar
npm-debug.log
yarn-error.log
.npm
.yarn-integrity

# ============================================================================
# IDE & EDITOR FILES
# ============================================================================
# Visual Studio Code
/.vscode/
.vscode/
*.code-workspace

# PHPStorm / IntelliJ
/.idea/
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Other editors
/.fleet
/.nova
/.zed
.phpactor.json

# ============================================================================
# OPERATING SYSTEM FILES
# ============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.nfs*

# ============================================================================
# BACKUP & EXPORT FILES
# ============================================================================
# Member data exports (contains sensitive information)
/storage/exports/*.xlsx
/storage/exports/*.csv
/storage/exports/*.pdf
/exports/
member_exports/
parish_data_*.xlsx

# System backups
/backups/
backup_*.tar.gz
*.backup

# ============================================================================
# DEVELOPMENT & TESTING FILES
# ============================================================================
# Testing
/coverage/
.coverage
.nyc_output
junit.xml

# Local development
Homestead.json
Homestead.yaml
Vagrantfile
.vagrant/
docker-compose.override.yml

# Debug files
debug_*.php
test_*.php
test-*.php
/storage/debugbar/

# Test and analysis files
*.test.php
*_test.php

# ============================================================================
# DOCUMENTATION FILES - EXCLUDE ALL .MD FILES EXCEPT README.MD
# ============================================================================
# Exclude all .md files except README.md as requested for production
*.md
!README.md

# ============================================================================
# PARISH-SPECIFIC SENSITIVE FILES
# ============================================================================
# Member photos and documents (if stored locally)
/storage/member-photos/
/storage/documents/
/public/uploads/

# Financial records
/storage/financial-reports/
tithe_records_*.xlsx
financial_summary_*.pdf

# ============================================================================
# DEPLOYMENT & SERVER FILES
# ============================================================================
# Deployment logs
deployment.log
*.deployment.log
logs/deployment_*.log

# Server configuration files (may contain sensitive paths)
.htaccess
.htpasswd
nginx.conf
apache.conf

# SSL certificates
*.pem
*.crt
*.key
*.csr
*.p12

# ============================================================================
# TEMPORARY & LOCK FILES
# ============================================================================
# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# ============================================================================
# SECURITY & ANALYSIS TOOLS
# ============================================================================
# Security scan results
/security-scan-results/
.security/

# ============================================================================
# ASSETS & MEDIA
# ============================================================================
# Large media files
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.webm

# Large images
*.psd
*.ai
*.eps

# ============================================================================
# END OF .GITIGNORE
# ============================================================================
# Additional development files to ignore
debug_*.php
test_*.php
test-*.php
*_test.php
*.test.php
/storage/debugbar/
/storage/logs/*.log

# Development documentation
/MYSQL_MIGRATION_GUIDE.md
/DEPLOYMENT_PRODUCTION_GUIDE.md
/PRODUCTION_DEPLOYMENT_GUIDE.md
/MEMBER_REGISTRATION_ANALYSIS.md
/MEMBER_REGISTRATION_RESOLUTION.md
/DATABASE_ENHANCEMENT_REPORT.md

# Keep only essential documentation
!/README.md
!/LICENSE
