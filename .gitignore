# ============================================================================
# PARISH MANAGEMENT SYSTEM - PRODUCTION .GITIGNORE
# ============================================================================
# This file prevents sensitive and unnecessary files from being committed to Git
# Optimized for production deployment to GitHub
# ============================================================================

# ============================================================================
# ENVIRONMENT FILES (CRITICAL - NEVER COMMIT)
# ============================================================================
.env
.env.*
!.env.example
!.env.docker
!.env.production.docker
.env.backup
.env.production
.env.local
.env.staging
.env.testing

# Authentication & API Keys
auth.json
oauth-private.key
oauth-public.key

# ============================================================================
# DOCKER FILES
# ============================================================================
# Docker environment overrides
docker-compose.override.yml
.docker/

# Docker volumes (data persistence)
docker/volumes/
mysql-data/
redis-data/

# Docker build cache
.dockerignore.local

# ============================================================================
# DATABASE FILES (CRITICAL - CONTAINS SENSITIVE DATA)
# ============================================================================
# SQLite databases
*.sqlite
*.sqlite3
*.db
/database/*.sqlite
/database/*.sqlite3
/database/*.db
/database/database.*

# Database backups and dumps
*.sql
*.dump
/database/backups/
/storage/database-backups/

# ============================================================================
# APPLICATION LOGS & TEMPORARY FILES
# ============================================================================
# Laravel logs
/storage/logs/*.log
/storage/logs/*

# General log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================================
# GENERATED & CACHED FILES
# ============================================================================
# Laravel optimization files
/bootstrap/cache/*.php
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
/storage/framework/testing/

# Compiled assets (Allow production builds, ignore development artifacts)
/public/hot
/public/storage
mix-manifest.json.backup

# Cache files
.phpunit.result.cache
.phpunit.cache
/storage/pail
*.cache

# ============================================================================
# DEPENDENCIES & PACKAGES
# ============================================================================
# Node.js modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PHP dependencies
/vendor/
composer.phar
npm-debug.log
yarn-error.log
.npm
.yarn-integrity

# ============================================================================
# IDE & EDITOR FILES
# ============================================================================
# Visual Studio Code
/.vscode/
.vscode/
*.code-workspace

# PHPStorm / IntelliJ
/.idea/
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Other editors
/.fleet
/.nova
/.zed
.phpactor.json

# ============================================================================
# OPERATING SYSTEM FILES
# ============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.nfs*

# ============================================================================
# BACKUP & EXPORT FILES
# ============================================================================
# Member data exports (contains sensitive information)
/storage/exports/*.xlsx
/storage/exports/*.csv
/storage/exports/*.pdf
/exports/
member_exports/
parish_data_*.xlsx

# System backups
/backups/
backup_*.tar.gz
*.backup

# ============================================================================
# DEVELOPMENT & TESTING FILES
# ============================================================================
# Testing
/coverage/
.coverage
.nyc_output
junit.xml

# Local development
Homestead.json
Homestead.yaml
Vagrantfile
.vagrant/
docker-compose.override.yml

# Debug files
debug_*.php
test_*.php
test-*.php
/storage/debugbar/

# Test and analysis files
*.test.php
*_test.php

# ============================================================================
# DOCUMENTATION FILES - INCLUDE ESSENTIAL PRODUCTION DOCUMENTATION
# ============================================================================
# Include essential production documentation
!README.md
!DEPLOYMENT_INSTRUCTIONS.md
!PRODUCTION_READY_SUMMARY.md
!SHELL_SCRIPTS_ANALYSIS.md

# Exclude development documentation
DEPLOYMENT_ANALYSIS_COMPLETE.md
DEPLOYMENT_CHECKLIST.md
PRODUCTION_DEPLOYMENT_GUIDE.md

# ============================================================================
# PARISH-SPECIFIC SENSITIVE FILES
# ============================================================================
# Member photos and documents (if stored locally)
/storage/member-photos/
/storage/documents/
/public/uploads/

# Financial records
/storage/financial-reports/
tithe_records_*.xlsx
financial_summary_*.pdf

# ============================================================================
# DEPLOYMENT & SERVER FILES
# ============================================================================
# Deployment logs
deployment.log
*.deployment.log
logs/deployment_*.log

# Server configuration files (may contain sensitive paths)
.htaccess
.htpasswd
nginx.conf
apache.conf

# SSL certificates
*.pem
*.crt
*.key
*.csr
*.p12

# ============================================================================
# TEMPORARY & LOCK FILES
# ============================================================================
# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# ============================================================================
# SECURITY & ANALYSIS TOOLS
# ============================================================================
# Security scan results
/security-scan-results/
.security/

# ============================================================================
# ASSETS & MEDIA
# ============================================================================
# Large media files
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.webm

# Large images
*.psd
*.ai
*.eps

# ============================================================================
# END OF .GITIGNORE
# ============================================================================

# Keep only essential documentation
!/README.md
!/LICENSE
!/DEPLOYMENT_INSTRUCTIONS.md
!/PRODUCTION_READY_SUMMARY.md
!/SHELL_SCRIPTS_ANALYSIS.md

# ============================================================================
# PRODUCTION BUILD ASSETS - INCLUDE ALL BUILD FILES
# ============================================================================
# Force include all production build assets (critical for deployment)
!/public/build/
!/public/build/**
!/public/build/assets/
!/public/build/assets/**
!/public/build/manifest.json

# ============================================================================
# DEPLOYMENT SCRIPTS - INCLUDE ESSENTIAL PRODUCTION SCRIPTS
# ============================================================================
# Include essential deployment scripts
!prepare-deployment.sh
!server-optimize.sh
!verify-assets.sh

# Exclude old/redundant scripts (already removed)
build-and-deploy.sh
deploy-to-production.sh
build-production.sh
migrate-sqlite-to-mysql.sh
sqlite-to-mysql.sh
production-deploy-fix.sh
